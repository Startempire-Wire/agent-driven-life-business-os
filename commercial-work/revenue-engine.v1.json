        "routine-template://cross-domain/reconciliation@1.0.0"
      ],
      "input_classes": [
        "qualified_prospect",
        "dedupe_sources",
        "consent_status"
      ],
      "result_class": "crm_record_ref_or_noop",
      "evidence_requirement": "exact_crm_record_and_dedupe_receipt",
      "external_effect": "source_mutation"
    },
    {
      "stage_key": "prepare_outreach",
      "step_class": "bounded_semantic",
      "trigger_kind": "event",
