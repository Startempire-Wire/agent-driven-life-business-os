      "evidence_requirement": "versioned_scope_pricing_and_terms",
      "external_effect": "prepare"
    },
    {
      "stage_key": "accept_commitment",
      "step_class": "deterministic",
      "trigger_kind": "manual",
      "task_pack_refs": [
        "TP-CUSTOMER-01"
      ],
      "routine_template_refs": [
        "routine-template://cross-domain/follow-through@1.0.0"
      ],
      "input_classes": [
        "offer_ref",
        "authorized_acceptance"
      ],
      "result_class": "accepted_commitment_ref",
      "evidence_requirement": "signed_or_source_verified_acceptance",
      "external_effect": "financial_commitment"
    },
    {
      "stage_key": "reconcile_settled_cash",
      "step_class": "deterministic",
      "trigger_kind": "event",
      "task_pack_refs": [
        "TP-CRM-01"
      ],
      "routine_template_refs": [
        "routine-template://cross-domain/finance-operations@1.0.0",
        "routine-template://cross-domain/reconciliation@1.0.0"
      ],
      "input_classes": [
        "payment_provider_ref",
        "invoice_state"
      ],
      "result_class": "settled_cash_or_unsettled",
      "evidence_requirement": "authoritative_settlement_receipt_currency",
      "external_effect": "none"
    },
    {
      "stage_key": "verify_customer_value",
      "step_class": "deterministic",
      "trigger_kind": "event",
      "task_pack_refs": [
        "TP-REPORT-01"
      ],
      "routine_template_refs": [
        "routine-template://business/delivery-case-review@1.0.0",
        "routine-template://cross-domain/evidence-closure@1.0.0"
      ],
      "input_classes": [
        "accepted_commitment",
        "delivery_source"
      ],
      "result_class": "customer_accepted_or_open",
      "evidence_requirement": "customer_receiver_acceptance_ref",
      "external_effect": "none"
    },
    {
      "stage_key": "retain_expand_refer",
      "step_class": "bounded_semantic",
      "trigger_kind": "condition",
      "task_pack_refs": [
        "TP-OPPORTUNITY-01",
        "TP-ANALYTICS-01"
      ],
      "routine_template_refs": [
        "routine-template://cross-domain/quiet-kaizen@1.0.0",
        "routine-template://cross-domain/follow-through@1.0.0"
      ],
      "input_classes": [
        "customer_accepted_outcome",
        "relationship_policy"
      ],
      "result_class": "follow_on_opportunity_or_noop",
      "evidence_requirement": "consented_relationship_and_outcome_provenance",
      "external_effect": "prepare"
    }
  ],
