{
  "schema_version": "operator.commercial_work.v1",
  "profile_id": "commercial-work://business/revenue-engine",
  "profile_version": "1.0.0",
  "status": "candidate",
  "description": "Owner-neutral, provider-replaceable prospecting-to-cash-to-customer-success process compiled per owner/business. The source CRM and financial providers retain truth; the Chief of Staff supervises governed assignments.",
  "fit_signals": [
    "owner declares revenue growth goal",
    "business has or wants a legitimate lead source",
    "sales lifecycle needs recurring follow-up",
    "offer catalog and payment truth can be identified"
  ],
  "contraindications": [
    "no business/offer authority",
    "source consent or suppression unavailable",
    "prohibited or restricted outreach channel",
    "unverified product claims/pricing"
  ],
  "stages": [
    {
      "stage_key": "discover",
      "step_class": "bounded_semantic",
      "trigger_kind": "schedule",
      "task_pack_refs": [
        "TP-OPPORTUNITY-01"
      ],
      "routine_template_refs": [
        "routine-template://cross-domain/reconciliation@1.0.0"
      ],
      "input_classes": [
        "market_evidence",
        "excluded_segments"
      ],
      "result_class": "sourced_opportunity",
      "evidence_requirement": "public_or_permitted_source_ref",
      "external_effect": "none"
    },
    {
      "stage_key": "qualify",
      "step_class": "bounded_semantic",
      "trigger_kind": "event",
      "task_pack_refs": [
        "TP-OPPORTUNITY-01",
        "TP-CRM-01"
      ],
      "routine_template_refs": [
        "routine-template://cross-domain/reconciliation@1.0.0"
      ],
      "input_classes": [
        "prospect_ref",
        "offer_readiness"
