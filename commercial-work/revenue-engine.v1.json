      "external_effect": "prepare"
    },
    {
      "stage_key": "engage",
      "step_class": "deterministic",
      "trigger_kind": "manual",
      "task_pack_refs": [
        "TP-CUSTOMER-01"
      ],
      "routine_template_refs": [
        "routine-template://cross-domain/follow-up@1.2.0"
