        "TP-CRM-01",
        "TP-FOLLOWUP-01"
      ],
      "routine_template_refs": [
        "routine-template://cross-domain/follow-up@1.2.0",
        "routine-template://cross-domain/follow-through@1.0.0"
      ],
      "input_classes": [
        "crm_stage",
        "response_state",
        "commitment_refs"
      ],
      "result_class": "next_due_action_or_terminal",
      "evidence_requirement": "source_stage_and_follow_through_ref",
      "external_effect": "source_mutation"
