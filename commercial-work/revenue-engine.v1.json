        "draft_ref",
        "suppressions",
        "send_authority"
      ],
      "result_class": "verified_send_or_blocked",
      "evidence_requirement": "provider_message_receipt_or_blocked_reason",
      "external_effect": "external_contact"
    },
    {
      "stage_key": "triage_reply",
      "step_class": "bounded_semantic",
      "trigger_kind": "event",
      "task_pack_refs": [
        "TP-CUSTOMER-01"
