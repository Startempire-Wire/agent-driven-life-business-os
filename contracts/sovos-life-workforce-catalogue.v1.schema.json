{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startempire-wire.github.io/agent-driven-life-business-os/contracts/sovos-life-workforce-catalogue.v1.schema.json",
  "title": "SOVOS life workforce catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalogue_version",
    "status",
    "authoring_date",
    "source_workforce_document",
    "source_focusa_registry",
    "authority",
    "worker_template_count",
    "disclaimers",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": "sovos.life_workforce_catalogue.v1"
    },
    "catalogue_version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "authoring_date": {
      "type": "string"
    },
    "source_workforce_document": {
      "type": "string"
    },
    "source_focusa_registry": {
      "type": "object"
    },
    "authority": {
      "type": "string"
    },
    "worker_template_count": {
      "type": "integer",
      "minimum": 1
    },
    "disclaimers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "role_name",
          "status",
          "domain_class",
          "summary",
          "example_scenario",
          "worker_form",
          "worker_lifetime_description",
          "activation_modes",
          "state_posture",
          "focusa_bundle_ids",
          "uiai_bundle_ids",
          "crist_input_classes",
          "human_reservations",
          "acceptance_evidence",
          "task_pack_ref",
          "source_document",
          "disclosure_status",
          "lifecycle_rule"
        ],
        "properties": {
          "profile_id": {
            "type": "string"
          },
          "role_name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "domain_class": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "example_scenario": {
            "type": "string"
          },
          "worker_form": {
            "type": "string"
          },
          "worker_lifetime_description": {
            "type": "string"
          },
          "activation_modes": {
            "type": "string"
          },
          "state_posture": {
            "type": "string"
          },
          "focusa_bundle_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uiai_bundle_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "crist_input_classes": {
            "type": "string"
          },
          "human_reservations": {
            "type": "string"
          },
          "acceptance_evidence": {
            "type": "string"
          },
          "task_pack_ref": {
            "type": "string"
          },
          "source_document": {
            "type": "string"
          },
          "disclosure_status": {
            "type": "string"
          },
          "lifecycle_rule": {
            "type": "string"
          }
        }
      }
    }
  }
}
