{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startempire-wire.github.io/agent-driven-life-business-os/contracts/operator-routine-template.v1.schema.json",
  "title": "Operator Routine Template v1",
  "description": "Portable, owner-neutral reusable routine pattern. A template suggests structure; it is not an assignment, schedule, authority grant, or active routine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "template_version",
    "status",
    "classification",
    "purpose",
    "fit",
    "trigger_policy",
    "step_skeleton",
    "human_boundary",
    "reliability_defaults",
    "measurement_defaults",
    "parameters",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "operator.routine_template.v1"
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "template_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "recommended",
        "stable",
        "deprecated"
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_classes",
        "routine_family",
        "archetype_tags"
      ],
      "properties": {
        "domain_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "life",
              "business",
              "cross_domain"
            ]
          }
        },
        "routine_family": {
          "enum": [
            "orientation",
            "intake_triage",
            "follow_up",
            "follow_through",
            "reconciliation",
            "delivery_review",
            "renewal_expiry",
            "finance_ops",
            "content_distribution",
            "system_health",
            "knowledge_freshness",
            "evidence_closure",
            "learning_improvement",
            "workforce_dispatch",
            "incident_response",
            "planning",
            "maintenance",
            "custom"
          ]
        },
        "archetype_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "outcome_classes"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "outcome_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_signal_classes",
        "optional_signal_classes",
        "exclusion_signal_classes",
        "evidence_floor"
      ],
      "properties": {
        "required_signal_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "optional_signal_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exclusion_signal_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_floor": {
          "enum": [
            "owner_declared",
            "one_source",
            "corroborated"
          ]
        }
      }
    },
    "trigger_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_kind",
        "allowed_kinds",
        "event_preferred",
        "default_cadence"
      ],
      "properties": {
        "preferred_kind": {
          "enum": [
            "manual",
            "schedule",
            "event",
            "condition",
            "queue"
          ]
        },
        "allowed_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "manual",
              "schedule",
              "event",
              "condition",
              "queue"
            ]
          }
        },
        "event_preferred": {
          "type": "boolean"
        },
        "default_cadence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "step_skeleton": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_key",
          "kind",
          "determinism",
          "purpose",
          "required_input_classes",
          "output_classes",
          "consequence_class"
        ],
        "properties": {
          "step_key": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "deterministic",
              "agentic",
              "uiai",
              "human"
            ]
          },
          "determinism": {
            "enum": [
              "must_be_deterministic",
              "prefer_deterministic",
              "bounded_semantic",
              "human_reserved"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "operation_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_input_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "output_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "consequence_class": {
            "enum": [
              "read",
              "prepare",
              "mutate",
              "external_commitment",
              "human_reserved"
            ]
          }
        }
      }
    },
    "human_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserved_decision_classes",
        "escalation_conditions",
        "confirmation_posture"
      ],
      "properties": {
        "reserved_decision_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "escalation_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confirmation_posture": {
          "enum": [
            "none",
            "exception_only",
            "always"
          ]
        }
      }
    },
    "reliability_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlap_policy",
        "missed_run_policy",
        "idempotency_required",
        "timeout_seconds",
        "retry_policy_class",
        "failure_destination_class"
      ],
      "properties": {
        "overlap_policy": {
          "enum": [
            "skip",
            "queue",
            "coalesce",
            "reconcile",
            "deny"
          ]
        },
        "missed_run_policy": {
          "enum": [
            "skip",
            "catch_up",
            "reconcile",
            "owner_attention"
          ]
        },
        "idempotency_required": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "retry_policy_class": {
          "type": "string",
          "minLength": 1
        },
        "failure_destination_class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurement_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_classes",
        "outcome_classes",
        "leverage_dimensions"
      ],
      "properties": {
        "evidence_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "outcome_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "leverage_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "outcome",
              "capacity_buyback",
              "attention_reduction",
              "cycle_time",
              "reliability",
              "cost_efficiency",
              "risk_reduction",
              "reuse",
              "opportunity_unlock",
              "compounding"
            ]
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value_type",
          "required",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "enum": [
              "string",
              "boolean",
              "integer",
              "number",
              "ref",
              "ref_list",
              "string_list"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_private_payload",
        "contains_secret_material"
      ],
      "properties": {
        "contains_private_payload": {
          "const": false
        },
        "contains_secret_material": {
          "const": false
        }
      }
    }
  }
}
