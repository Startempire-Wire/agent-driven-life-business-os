{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startempire-wire.github.io/agent-driven-life-business-os/contracts/operator-commercial-work.v1.schema.json",
  "title": "SOVOS Commercial Work Profile v1",
  "description": "Portable revenue-work composition contract. Not a CRM, granted skill, scheduler, active routine or source of accepted financial truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "status",
    "description",
    "fit_signals",
    "contraindications",
    "stages",
    "workforce",
    "routine_pack_ref",
    "routine_template_refs",
    "source_truth",
    "authority_law",
    "reliability_law",
    "outcome_law",
    "required_private_binding_keys",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "operator.commercial_work.v1"
    },
    "profile_id": {
      "const": "commercial-work://business/revenue-engine"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "candidate",
        "recommended",
        "stable",
        "deprecated"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "fit_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contraindications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_key",
          "step_class",
          "trigger_kind",
          "task_pack_refs",
          "routine_template_refs",
          "input_classes",
          "result_class",
          "evidence_requirement",
          "external_effect"
        ],
        "properties": {
          "stage_key": {
            "enum": [
              "discover",
              "qualify",
              "admit_to_crm",
              "prepare_outreach",
              "engage",
              "triage_reply",
              "advance_opportunity",
              "prepare_offer",
              "accept_commitment",
              "reconcile_settled_cash",
              "verify_customer_value",
              "retain_expand_refer"
            ]
          },
          "step_class": {
            "enum": [
              "deterministic",
              "bounded_semantic",
              "human_reserved"
            ]
          },
          "trigger_kind": {
            "enum": [
              "event",
              "schedule",
              "condition",
              "manual"
            ]
          },
          "task_pack_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "routine_template_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "input_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "result_class": {
            "type": "string",
            "minLength": 1
          },
          "evidence_requirement": {
            "type": "string",
            "minLength": 1
          },
          "external_effect": {
            "enum": [
              "none",
              "prepare",
              "source_mutation",
              "external_contact",
              "financial_commitment"
            ]
          }
        }
      }
    },
    "workforce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chief_of_staff_role_ref",
        "specialist_role_refs",
        "task_pack_refs",
        "assignment_model"
      ],
      "properties": {
        "chief_of_staff_role_ref": {
          "const": "COS-01"
        },
        "specialist_role_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "task_pack_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "assignment_model": {
          "const": "owner-scoped CRIST to Focusa, episodic workers as justified"
        }
      }
    },
    "routine_pack_ref": {
      "const": "routine-pack://business/revenue-engine@1.0.0"
    },
    "routine_template_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crm",
        "mail",
        "payment",
        "work",
        "accepted_outcome",
        "cross_portal_merging_default"
      ],
      "properties": {
        "crm": {
          "const": "owning CRM per account/business"
        },
        "mail": {
          "const": "owning communication provider"
        },
        "payment": {
          "const": "owning payment/accounting provider"
        },
        "work": {
          "const": "Focusa governed work"
        },
        "accepted_outcome": {
          "const": "owning business/source and owner acceptance as applicable"
        },
        "cross_portal_merging_default": {
          "const": false
        }
      }
    },
    "authority_law": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_send_default",
        "outbound_requires_scoped_grant",
        "contact_suppression_check",
        "new_pricing_or_commitment_reserved",
        "entitlement_not_authority",
        "cross_business_least_access"
      ],
      "properties": {
        "external_send_default": {
          "const": "prepare_only"
        },
        "outbound_requires_scoped_grant": {
          "const": true
        },
        "contact_suppression_check": {
          "const": true
        },
        "new_pricing_or_commitment_reserved": {
          "const": true
        },
        "entitlement_not_authority": {
          "const": true
        },
        "cross_business_least_access": {
          "const": true
        }
      }
    },
    "reliability_law": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduler_owner",
        "separate_scheduler_forbidden",
        "replay_safe_actions_required",
        "missed_runs_reconcile",
        "revalidate_before_effect",
        "failed_delivery_is_not_success"
      ],
      "properties": {
        "scheduler_owner": {
          "const": "OpenClaw or applicable provider-native owner"
        },
        "separate_scheduler_forbidden": {
          "const": true
        },
        "replay_safe_actions_required": {
          "const": true
        },
        "missed_runs_reconcile": {
          "const": true
        },
        "revalidate_before_effect": {
          "const": true
        },
        "failed_delivery_is_not_success": {
          "const": true
        }
      }
    },
    "outcome_law": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_prospect_is_sale",
        "crm_closed_won_is_settled_cash",
        "invoice_is_settled_cash",
        "provider_payment_evidence_required",
        "customer_delivery_separate_from_payment",
        "verified_outcomes_measure_leverage"
      ],
      "properties": {
        "qualified_prospect_is_sale": {
          "const": false
        },
        "crm_closed_won_is_settled_cash": {
          "const": false
        },
        "invoice_is_settled_cash": {
          "const": false
        },
        "provider_payment_evidence_required": {
          "const": true
        },
        "customer_delivery_separate_from_payment": {
          "const": true
        },
        "verified_outcomes_measure_leverage": {
          "const": true
        }
      }
    },
    "required_private_binding_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "owner_ref",
          "business_ref",
          "crm_source_refs",
          "offer_catalog_ref",
          "contact_policy_ref",
          "communications_policy_ref",
          "payment_source_ref",
          "delivery_acceptance_ref",
          "chief_of_staff_ref",
          "focusa_assignment_ref"
        ]
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_private_payload",
        "contains_secret_material"
      ],
      "properties": {
        "contains_private_payload": {
          "const": false
        },
        "contains_secret_material": {
          "const": false
        }
      }
    }
  }
}
