{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startempire-wire.github.io/agent-driven-life-business-os/contracts/operator-environment.v1.schema.json",
  "title": "Operator Environment v1",
  "description": "Machine-readable SOVOS deployment invariant: one owner-specific persistent VPS joined by Tailscale to one or more owner-controlled local bodies, with Operating Partner residency allowed on cloud, local, or both without changing partner identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_id",
    "owner_ref",
    "deployment_posture",
    "persistent_vps",
    "private_mesh",
    "residency",
    "management",
    "privacy"
  ],
  "properties": {
    "schema_version": { "const": "operator.environment.v1" },
    "environment_id": { "type": "string", "minLength": 1 },
    "owner_ref": { "type": "string", "minLength": 1 },
    "deployment_posture": { "const": "sovereign_operator" },
    "persistent_vps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_ref", "dedicated_to_owner", "always_available_required"],
      "properties": {
        "body_ref": { "type": "string", "minLength": 1 },
        "provider_ref": { "type": ["string", "null"] },
        "dedicated_to_owner": { "const": true },
        "always_available_required": { "const": true }
      }
    },
    "private_mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "tailnet_ref",
        "vps_member_ref",
        "local_body_refs",
        "cross_owner_default"
      ],
      "properties": {
        "provider": { "const": "tailscale" },
        "tailnet_ref": { "type": "string", "minLength": 1 },
        "vps_member_ref": { "type": "string", "minLength": 1 },
        "local_body_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "cross_owner_default": { "const": "deny" }
      }
    },
    "residency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_partner_ref",
        "mode",
        "active_body_refs",
        "partner_identity_continuity_required"
      ],
      "properties": {
        "operating_partner_ref": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["cloud_vps", "local_body", "hybrid"] },
        "active_body_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "partner_identity_continuity_required": { "const": true }
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "shared_runtime_allowed"],
      "properties": {
        "model": { "enum": ["customer_managed", "operator_managed", "hybrid"] },
        "shared_runtime_allowed": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_private_payload", "contains_secret_material"],
      "properties": {
        "contains_private_payload": { "const": false },
        "contains_secret_material": { "const": false }
      }
    }
  }
}
