{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startempire-wire.github.io/agent-driven-life-business-os/contracts/operator-routine-instance.v1.schema.json",
  "title": "Operator Routine Instance v1",
  "description": "Compiled executable binding of one accepted routine blueprint. It binds exact scope, trigger, steps, authority, reliability and acceptance without becoming the canonical scheduler/work/evidence store.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "status",
    "template_ref",
    "blueprint_ref",
    "blueprint_revision",
    "scope",
    "trigger_binding",
    "supervision",
    "compiled_steps",
    "authority_binding",
    "reliability_binding",
    "acceptance",
    "lifecycle",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "operator.routine_instance.v1"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "compiled",
        "shadow",
        "pilot",
        "active",
        "paused",
        "blocked",
        "retired"
      ]
    },
    "template_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "blueprint_ref": {
      "type": "string",
      "minLength": 1
    },
    "blueprint_revision": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_ref",
        "business_refs",
        "life_domain_refs"
      ],
      "properties": {
        "owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "business_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "life_domain_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "portfolio_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "business_refs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "life_domain_refs": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "trigger_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "binding_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "schedule",
            "event",
            "condition",
            "queue"
          ]
        },
        "binding_ref": {
          "type": "string",
          "minLength": 1
        },
        "scheduler_class": {
          "enum": [
            "openclaw_automation",
            "native_service",
            "provider_scheduler",
            "other"
          ]
        },
        "scheduler_owner_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "schedule_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "supervision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_partner_ref",
        "focusa_assignment_ref",
        "workstream_ref"
      ],
      "properties": {
        "operating_partner_ref": {
          "type": "string",
          "minLength": 1
        },
        "focusa_assignment_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "workstream_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "foreman_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "compiled_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "kind",
          "determinism",
          "input_binding_refs",
          "output_schema_ref",
          "consequence_class",
          "idempotency_key_strategy"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "deterministic",
              "agentic",
              "uiai",
              "human"
            ]
          },
          "determinism": {
            "enum": [
              "deterministic",
              "bounded_semantic",
              "human_reserved"
            ]
          },
          "operation_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision_policy_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_contract_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "attention_policy_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_binding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "output_schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "consequence_class": {
            "enum": [
              "read",
              "prepare",
              "mutate",
              "external_commitment",
              "human_reserved"
            ]
          },
          "idempotency_key_strategy": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "deterministic"
                }
              }
            },
            "then": {
              "properties": {
                "operation_ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operation_ref"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "agentic"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "properties": {
                    "decision_policy_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "decision_policy_ref"
                  ]
                },
                {
                  "properties": {
                    "prompt_contract_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "prompt_contract_ref"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "human"
                }
              }
            },
            "then": {
              "properties": {
                "attention_policy_ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "attention_policy_ref"
              ]
            }
          }
        ]
      }
    },
    "authority_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_refs",
        "credential_use_refs",
        "human_boundary_policy_ref"
      ],
      "properties": {
        "grant_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "credential_use_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "budget_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_boundary_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "reliability_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_ref",
        "overlap_policy",
        "missed_run_policy",
        "timeout_seconds",
        "retry_policy_ref",
        "failure_attention_ref",
        "rollback_ref",
        "revoke_ref"
      ],
      "properties": {
        "lock_ref": {
          "type": "string",
          "minLength": 1
        },
        "overlap_policy": {
          "enum": [
            "skip",
            "queue",
            "coalesce",
            "reconcile",
            "deny"
          ]
        },
        "missed_run_policy": {
          "enum": [
            "skip",
            "catch_up",
            "reconcile",
            "owner_attention"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "retry_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "failure_attention_ref": {
          "type": "string",
          "minLength": 1
        },
        "rollback_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "revoke_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_requirement_refs",
        "acceptance_policy_ref",
        "accepted_outcome_refs"
      ],
      "properties": {
        "evidence_requirement_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "acceptance_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "accepted_outcome_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiled_at",
        "compiler_version",
        "instance_revision"
      ],
      "properties": {
        "compiled_at": {
          "type": "string",
          "format": "date-time"
        },
        "compiler_version": {
          "type": "string",
          "minLength": 1
        },
        "instance_revision": {
          "type": "string",
          "minLength": 1
        },
        "activated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "paused_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retired_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_private_payload",
        "contains_secret_material"
      ],
      "properties": {
        "contains_private_payload": {
          "const": false
        },
        "contains_secret_material": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "pilot",
              "active",
              "paused"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "supervision": {
            "properties": {
              "focusa_assignment_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "authority_binding": {
            "properties": {
              "grant_refs": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "lifecycle": {
            "required": [
              "activated_at"
            ],
            "properties": {
              "activated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trigger_binding": {
            "properties": {
              "kind": {
                "const": "schedule"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "trigger_binding": {
            "required": [
              "schedule_ref",
              "scheduler_owner_ref",
              "timezone"
            ],
            "properties": {
              "schedule_ref": {
                "type": "string",
                "minLength": 1
              },
              "scheduler_owner_ref": {
                "type": "string",
                "minLength": 1
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
