{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startempire-wire.github.io/agent-driven-life-business-os/contracts/operator-commercial-work-binding.v1.schema.json",
  "title": "SOVOS Customer Revenue Work Binding v1",
  "description": "Private customer-specific references binding portable revenue work to existing CRM, payment, workforce and scheduler authorities. No tokens, contact records or provider payloads in this envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_ref",
    "binding_id",
    "binding_revision",
    "status",
    "scope",
    "source_bindings",
    "product_routes",
    "supervision",
    "automation",
    "governance",
    "verification",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "operator.commercial_work_binding.v1"
    },
    "profile_ref": {
      "const": "commercial-work://business/revenue-engine@1.0.0"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "proposed",
        "shadow",
        "pilot",
        "active",
        "paused",
        "retired"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_ref",
        "business_ref",
        "additional_business_refs"
      ],
      "properties": {
        "owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "business_ref": {
          "type": "string",
          "minLength": 1
        },
        "additional_business_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_class",
          "provider",
          "source_ref",
          "access_state",
          "credential_use_refs"
        ],
        "properties": {
          "source_class": {
            "enum": [
              "primary_crm",
              "relationship_crm",
              "communication",
              "offer_catalog",
              "payment",
              "delivery"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "access_state": {
            "enum": [
              "unverified",
              "read_verified",
              "write_verified"
            ]
          },
          "credential_use_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "product_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offer_ref",
          "offer_class",
          "setup_mode",
          "terms_policy_ref",
          "readiness_ref",
          "environment_ref"
        ],
        "properties": {
          "offer_ref": {
            "type": "string",
            "minLength": 1
          },
          "offer_class": {
            "enum": [
              "focusa_license",
              "uiai_license",
              "software_bundle",
              "operator_deployment",
              "other_customer_offer"
            ]
          },
          "setup_mode": {
            "enum": [
              "wirebot_sovereign_operator",
              "wirebot_sovereign",
              "wirebot_direct",
              "wirebot_network",
              null
            ]
          },
          "terms_policy_ref": {
            "type": "string",
            "minLength": 1
          },
          "readiness_ref": {
            "type": "string",
            "minLength": 1
          },
          "environment_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "supervision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chief_of_staff_ref",
        "chief_of_staff_role_ref",
        "focusa_workstream_ref",
        "focusa_assignment_ref"
      ],
      "properties": {
        "chief_of_staff_ref": {
          "type": "string",
          "minLength": 1
        },
        "chief_of_staff_role_ref": {
          "const": "COS-01"
        },
        "focusa_workstream_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "focusa_assignment_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "routine_instance_refs",
        "scheduler_binding_refs"
      ],
      "properties": {
        "state": {
          "enum": [
            "unbound",
            "shadow",
            "pilot",
            "active",
            "paused"
          ]
        },
        "routine_instance_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scheduler_binding_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contact_policy_ref",
        "communications_policy_ref",
        "outbound_grant_refs",
        "crm_write_grant_refs",
        "opt_out_source_ref"
      ],
      "properties": {
        "contact_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "communications_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "outbound_grant_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "crm_write_grant_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "opt_out_source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payment_source_ref",
        "delivery_acceptance_ref",
        "first_value_evidence_ref",
        "cash_status"
      ],
      "properties": {
        "payment_source_ref": {
          "type": "string",
          "minLength": 1
        },
        "delivery_acceptance_ref": {
          "type": "string",
          "minLength": 1
        },
        "first_value_evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "cash_status": {
          "enum": [
            "unknown",
            "not_received",
            "partially_settled",
            "settled_verified"
          ]
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_private_payload",
        "contains_secret_material"
      ],
      "properties": {
        "contains_private_payload": {
          "const": false
        },
        "contains_secret_material": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "supervision": {
            "properties": {
              "focusa_assignment_ref": {
                "type": "string",
                "minLength": 1
              },
              "focusa_workstream_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "automation": {
            "properties": {
              "state": {
                "const": "active"
              },
              "routine_instance_refs": {
                "type": "array",
                "minItems": 1
              },
              "scheduler_binding_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "verification": {
            "properties": {
              "first_value_evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "governance": {
            "properties": {
              "crm_write_grant_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_bindings": {
            "contains": {
              "properties": {
                "source_class": {
                  "const": "primary_crm"
                },
                "access_state": {
                  "const": "write_verified"
                }
              },
              "required": [
                "source_class",
                "access_state"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_bindings": {
            "contains": {
              "properties": {
                "source_class": {
                  "const": "payment"
                },
                "access_state": {
                  "enum": [
                    "read_verified",
                    "write_verified"
                  ]
                }
              },
              "required": [
                "source_class",
                "access_state"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "product_routes": {
            "items": {
              "if": {
                "properties": {
                  "setup_mode": {
                    "enum": [
                      "wirebot_sovereign_operator",
                      "wirebot_sovereign"
                    ]
                  }
                },
                "required": [
                  "setup_mode"
                ]
              },
              "then": {
                "properties": {
                  "environment_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
