{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startempire-wire.github.io/agent-driven-life-business-os/contracts/agent-contract-change.v1.schema.json",
  "title": "Agent Contract Change Proposal v1",
  "description": "Portable reference envelope for one bounded, evidence-grounded agent-contract experiment. It is not a memory, policy, evidence, or approval database.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "status",
    "target",
    "hypothesis",
    "change",
    "observations",
    "evaluation",
    "authority",
    "rollout",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "agent.contract_change.v1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "observed",
        "corroborated",
        "proposed",
        "regression_tested",
        "approved",
        "rolled_out",
        "verified",
        "reverted"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "base_revision",
        "evolution_class"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        },
        "evolution_class": {
          "enum": [
            "constitutional",
            "safety_authority",
            "architecture_boundary",
            "portable_operational",
            "narrow_procedure",
            "product_local"
          ]
        }
      }
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "semantic_weakening"
      ],
      "properties": {
        "kind": {
          "enum": [
            "add",
            "rewrite",
            "move",
            "extract",
            "remove"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "semantic_weakening": {
          "type": "boolean"
        },
        "destination_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "observation_class",
          "correlation_key",
          "task_family",
          "observed_at"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "observation_class": {
            "enum": [
              "positive",
              "non_compliance",
              "harm",
              "gap",
              "orchestration_gap",
              "placement",
              "superseded"
            ]
          },
          "correlation_key": {
            "type": "string",
            "minLength": 1
          },
          "task_family": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "project_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "deployment_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "harness_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_case_refs",
        "holdout_case_refs",
        "protected_invariant_refs",
        "baseline_ref",
        "verdict"
      ],
      "properties": {
        "derived_case_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "holdout_case_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "protected_invariant_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "baseline_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "enum": [
            "not_run",
            "pass",
            "fail",
            "tradeoff_approved"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "approval_ref"
      ],
      "properties": {
        "requirement": {
          "enum": [
            "none",
            "owner",
            "architecture_delegate"
          ]
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "rollback_ref"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "rollback_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "post_rollout_observation_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portable_material",
        "contains_private_payload",
        "contains_secret_material"
      ],
      "properties": {
        "portable_material": {
          "enum": [
            "references_only",
            "redacted",
            "public"
          ]
        },
        "contains_private_payload": {
          "const": false
        },
        "contains_secret_material": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "change": {
            "properties": {
              "kind": {
                "const": "remove"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "change": {
            "properties": {
              "semantic_weakening": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "evolution_class": {
                "enum": [
                  "constitutional",
                  "safety_authority",
                  "architecture_boundary"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "requirement": {
                "enum": [
                  "owner",
                  "architecture_delegate"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "regression_tested",
              "approved",
              "rolled_out",
              "verified"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "holdout_case_refs": {
                "minItems": 1
              },
              "protected_invariant_refs": {
                "minItems": 1
              },
              "verdict": {
                "enum": [
                  "pass",
                  "tradeoff_approved"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "approved",
                  "rolled_out",
                  "verified"
                ]
              }
            }
          },
          {
            "properties": {
              "authority": {
                "properties": {
                  "requirement": {
                    "enum": [
                      "owner",
                      "architecture_delegate"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "approval_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "rolled_out",
              "verified"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "rollout": {
            "properties": {
              "rollback_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "rollout": {
            "properties": {
              "post_rollout_observation_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
