{
  "schema_version": "operator.routine_template.v1",
  "template_id": "routine-template://cross-domain/reconciliation",
  "template_version": "1.0.0",
  "status": "recommended",
  "classification": {
    "domain_classes": [
      "cross_domain"
    ],
    "routine_family": "reconciliation",
    "archetype_tags": [
      "finance",
      "operations",
      "multi-business",
      "household-administrator"
    ]
  },
  "purpose": {
    "summary": "Compare multiple source systems, identify disagreement, and resolve or escalate through the canonical owner of each fact.",
    "outcome_classes": [
      "reconciled_state",
      "contradiction_register"
    ]
  },
  "fit": {
    "required_signal_classes": [
      "two_or_more_source_refs"
    ],
    "optional_signal_classes": [
      "prior_reconciliation_ref"
    ],
    "exclusion_signal_classes": [],
    "evidence_floor": "one_source"
  },
  "trigger_policy": {
    "preferred_kind": "schedule",
    "allowed_kinds": [
      "schedule",
      "event",
      "manual"
    ],
    "event_preferred": false,
    "default_cadence": "daily, weekly or event-triggered depending on domain"
  },
  "step_skeleton": [
    {
      "step_key": "read_sources",
      "kind": "deterministic",
      "determinism": "must_be_deterministic",
      "purpose": "Read current revisions from canonical sources.",
      "operation_class": "source_read",
      "required_input_classes": [
        "two_or_more_source_refs"
      ],
      "output_classes": [
        "source_snapshots"
      ],
      "consequence_class": "read"
    },
    {
      "step_key": "diff",
      "kind": "deterministic",
      "determinism": "must_be_deterministic",
      "purpose": "Compute deterministic differences and missing states.",
      "operation_class": "source_diff",
      "required_input_classes": [
        "source_snapshots"
      ],
      "output_classes": [
        "difference_set"
      ],
      "consequence_class": "read"
    },
    {
      "step_key": "classify",
      "kind": "agentic",
      "determinism": "bounded_semantic",
      "purpose": "Classify discrepancies by ownership, consequence and settlement path.",
      "operation_class": null,
      "required_input_classes": [
        "difference_set"
      ],
      "output_classes": [
        "contradiction_register"
      ],
      "consequence_class": "prepare"
    },
    {
      "step_key": "settle_safe",
      "kind": "deterministic",
      "determinism": "must_be_deterministic",
      "purpose": "Apply only deterministic owner-authorized reconciliation writes.",
      "operation_class": "source_reconcile",
      "required_input_classes": [
        "contradiction_register"
      ],
      "output_classes": [
        "reconciled_state"
      ],
      "consequence_class": "mutate"
    }
  ],
  "human_boundary": {
    "reserved_decision_classes": [
      "ambiguous_source_truth",
      "financial_commitment"
    ],
    "escalation_conditions": [
      "canonical_owner_unclear",
      "high_consequence_disagreement"
    ],
    "confirmation_posture": "exception_only"
  },
  "reliability_defaults": {
    "overlap_policy": "coalesce",
    "missed_run_policy": "reconcile",
    "idempotency_required": true,
    "timeout_seconds": 900,
    "retry_policy_class": "bounded_backoff",
    "failure_destination_class": "owner_attention"
  },
  "measurement_defaults": {
    "evidence_classes": [
      "source_receipt",
      "routine_run_receipt"
    ],
    "outcome_classes": [
      "reconciled_state",
      "contradiction_register"
    ],
    "leverage_dimensions": [
      "attention_reduction",
      "reliability",
      "outcome"
    ]
  },
  "parameters": [
    {
      "name": "source_refs",
      "value_type": "ref_list",
      "required": true,
      "description": "Canonical sources to reconcile."
    }
  ],
  "privacy": {
    "contains_private_payload": false,
    "contains_secret_material": false
  }
}
